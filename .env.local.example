# Firebase Web App config — Console Firebase > ⚙️ Impostazioni progetto > Le tue app > Web
# Copia questo file in `.env.local` e incolla i valori del TUO progetto.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# App Check — Console Firebase > App Check > registra l'app web con reCAPTCHA v3.
# Senza questa chiave l'app funziona comunque, ma senza protezione anti-abuso.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Solo in sviluppo: token da Console > App Check > (tua app) > Gestisci token di debug.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
